# Editor password — REQUIRED. The server refuses to start if this is unset
# or left as "changeme". Use a long, random value.
EDITOR_PASSWORD=change-me-to-a-long-random-value
GIT_USER=github-username
# Fine-grained GitHub PAT. Treat as a secret: never commit it. The server
# authenticates via an HTTP header and never writes it to any .git/config.
GIT_TOKEN=ghp_xxxxxxxxxxxx
NODE_ENV=development
# Base path when serving behind a reverse proxy (e.g. /docs/)
# Must match the nginx location path. Leave as / for root deployment.
BASE_PATH=/
# VITE_BASE_PATH must match BASE_PATH (used by the client build)
VITE_BASE_PATH=/
